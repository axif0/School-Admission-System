# ==============================================================================
# School Admission System — Environment Configuration Reference
# ==============================================================================

# Database credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=school_admission

# Backend Database & Connection Budget Configuration
# Formula: EXPECTED_REPLICAS * DB_MAX_POOL_SIZE <= DB_MAX_CONNECTIONS - Reserved(3)
DB_MAX_POOL_SIZE=50
DB_LOCK_TIMEOUT_SECONDS=15
DB_MAX_CONNECTIONS=200
EXPECTED_REPLICAS=1
MIGRATION_ADVISORY_LOCK_KEY=123456789

# Connection string template
ConnectionStrings__Default=Host=db;Port=5432;Database=school_admission;Username=postgres;Password=postgres;Maximum Pool Size=50

# Hold reservation expiration duration in seconds (default: 600 = 10 minutes)
HOLD_DURATION_SECONDS=600

# Background hold sweeper configuration
SWEEPER_ENABLED=true
SWEEPER_INTERVAL_SECONDS=5

# Rate Limiting (default: false in dev; true in production override)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_HOLDS_PER_MINUTE_PER_STUDENT=10
RATE_LIMIT_PER_MINUTE_PER_IP=60

# Observability & Diagnostics
METRICS_ENABLED=false
SWAGGER_ENABLED=true

# CORS and Network Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000
ASPNETCORE_URLS=http://+:8080

# Frontend configuration (browser URL to API)
API_URL=http://localhost:8080

# Test database admin connection string
TEST_ADMIN_CONNECTION_STRING=Host=db;Port=5432;Database=postgres;Username=postgres;Password=postgres
