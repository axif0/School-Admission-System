# Database credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=school_admission

# Backend configuration
ConnectionStrings__Default=Host=db;Port=5432;Database=school_admission;Username=postgres;Password=postgres;Maximum Pool Size=50
HOLD_DURATION_SECONDS=600
CORS_ALLOWED_ORIGINS=http://localhost:3000
ASPNETCORE_URLS=http://+:8080

# Frontend configuration (browser URL to backend)
API_URL=http://localhost:8080

# Test database admin connection string
TEST_ADMIN_CONNECTION_STRING=Host=db;Port=5432;Database=postgres;Username=postgres;Password=postgres
